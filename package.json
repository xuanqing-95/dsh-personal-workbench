{
  "name": "dsh-personal-workbench",
  "version": "0.8.0-beta.1",
  "type": "module",
  "description": "个人主控台：每日计划、AI 助手、日报和项目都在一屏。",
  "exports": {
    ".": "./index.js",
    "./package.json": "./package.json",
    "./client": "./client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": [
    "index.js",
    "request.js",
    "planning.js",
    "tasks.js",
    "assistant-host.js",
    "assistant-service.js",
    "harness.js",
    "client.js",
    "cordis.patch.yml",
    "locale/*.json",
    "icon.svg",
    "project-shortcuts.js",
    "project-repository.js",
    "project-github.js",
    "project-tracking.js",
    "project-tools.js",
    "project-service.js",
    "project-navigation.js"
  ],
  "dependencies": {
    "zod": "4.4.3"
  },
  "engines": {
    "dsh": ">=0.2.2-rc.1 <0.2.3-0"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-ui-layout",
        "@deepseek-ai/dsh-client-ui-sidebar",
        "@deepseek-ai/dsh-client-locale",
        "@deepseek-ai/dsh-client-ui-workspace",
        "@deepseek-ai/dsh-api-session-controller",
        "@deepseek-ai/dsh-api-workspace-controller",
        "@deepseek-ai/dsh-client-ui-conversation"
      ]
    }
  },
  "keywords": [
    "dsh-plugin",
    "deepseek-harness",
    "dashboard",
    "planner"
  ],
  "scripts": {
    "test": "node --test *.test.js"
  }
}
