{
  "name": "dsh-personal-workbench",
  "version": "0.8.0-beta.6",
  "type": "module",
  "description": "个人主控台：用聊天管理计划、AI 日报与项目，五区玻璃卡片自由排布。",
  "exports": {
    ".": "./index.js",
    "./package.json": "./package.json",
    "./client": "./client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": [
    "index.js",
    "request.js",
    "planning.js",
    "tasks.js",
    "assistant-host.js",
    "assistant-service.js",
    "harness.js",
    "client.js",
    "cordis.patch.yml",
    "locale/*.json",
    "icon.svg",
    "project-shortcuts.js",
    "project-repository.js",
    "project-github.js",
    "project-tracking.js",
    "project-tools.js",
    "project-service.js",
    "project-navigation.js",
    "ui-update-host.js",
    "ui-release.json",
    "ui-update-client.js",
    "publish-ui.mjs",
    "content.js",
    "plan-tools.js",
    "LICENSE",
    "PRIVACY.md",
    "THIRD_PARTY_NOTICES.md"
  ],
  "dependencies": {
    "zod": "4.6.7"
  },
  "engines": {
    "dsh": ">=0.2.2-rc.1 <0.2.3-0"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-ui-layout",
        "@deepseek-ai/dsh-client-ui-sidebar",
        "@deepseek-ai/dsh-client-locale",
        "@deepseek-ai/dsh-client-ui-workspace",
        "@deepseek-ai/dsh-api-session-controller",
        "@deepseek-ai/dsh-api-workspace-controller",
        "@deepseek-ai/dsh-client-ui-conversation"
      ]
    }
  },
  "keywords": [
    "dsh-plugin",
    "deepseek-harness",
    "dashboard",
    "planner",
    "personal-workbench",
    "AI",
    "任务管理",
    "AI日报",
    "个人主控台"
  ],
  "scripts": {
    "test": "node --test *.test.js",
    "publish:ui": "node publish-ui.mjs",
    "release:seal": "node scripts/release.mjs seal",
    "release:verify": "node scripts/release.mjs verify"
  },
  "author": "玄清",
  "homepage": "https://xuanqing-95.github.io/dsh-personal-workbench/",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/xuanqing-95/dsh-personal-workbench.git"
  },
  "bugs": {
    "url": "https://github.com/xuanqing-95/dsh-personal-workbench/issues"
  },
  "license": "SEE LICENSE IN LICENSE"
}
