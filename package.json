{
  "name": "dsh-personal-workbench-xuanqing",
  "version": "0.8.6",
  "type": "module",
  "description": "一眼查看今日计划、每日 AI 资讯与正在进行的事，点击进入对应页面或对话。",
  "exports": {
    ".": "./index.js",
    "./package.json": "./package.json",
    "./client": "./client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": [
    "index.js",
    "request.js",
    "planning.js",
    "tasks.js",
    "assistant-host.js",
    "assistant-follow.js",
    "assistant-service.js",
    "harness.js",
    "client.js",
    "cordis.patch.yml",
    "locale/*.json",
    "icon.svg",
    "project-shortcuts.js",
    "project-repository.js",
    "project-github.js",
    "project-tracking.js",
    "project-tools.js",
    "project-service.js",
    "project-navigation.js",
    "ui-update-host.js",
    "release-status.js",
    "ui-release.json",
    "ui-update-client.js",
    "publish-ui.mjs",
    "content.js",
    "plan-tools.js",
    "LICENSE",
    "PRIVACY.md",
    "THIRD_PARTY_NOTICES.md",
    "workbench-design.css",
    "sync-design.mjs",
    "START-HERE.md",
    "automation-sources.js",
    "brief-connection.js",
    "project-store.js",
    "connect-chrome-store.mjs",
    "codex-catalog.js",
    "usage.js",
    "usage-core.js",
    "usage-worker.js",
    "weekly-plan.js",
    "notion-api.js",
    "notion-plans.js",
    "notion-plan-check.js",
    "weixin-meetings.js",
    "weixin-notifications.js",
    "weixin-notification-host.js",
    "local-plan-file.js",
    "brief-image.js",
    "organization-host.js",
    "organization.js",
    "plan-connection.js",
    "plan-file-connection.js",
    "plan-service-connection.js",
    "quota-connections.js",
    "first-run.js"
  ],
  "dependencies": {
    "zod": "4.6.7"
  },
  "engines": {
    "dsh": ">=0.2.2-rc.1 <0.2.3-0"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-ui-layout",
        "@deepseek-ai/dsh-client-ui-sidebar",
        "@deepseek-ai/dsh-client-locale",
        "@deepseek-ai/dsh-client-ui-workspace",
        "@deepseek-ai/dsh-api-session-controller",
        "@deepseek-ai/dsh-api-workspace-controller",
        "@deepseek-ai/dsh-client-ui-conversation"
      ]
    }
  },
  "keywords": [
    "dsh-plugin",
    "deepseek-harness",
    "dashboard",
    "planner",
    "personal-workbench",
    "AI",
    "任务管理",
    "AI日报",
    "个人 AI 工作台"
  ],
  "scripts": {
    "test": "node --test *.test.js",
    "publish:ui": "node publish-ui.mjs",
    "release:seal": "node scripts/release.mjs seal",
    "release:verify": "node scripts/release.mjs verify",
    "sync:design": "node sync-design.mjs",
    "check:design": "node sync-design.mjs --check"
  },
  "author": "XUANQING（玄清）",
  "homepage": "https://github.com/xuanqing-lab/dsh-personal-workbench",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/xuanqing-lab/dsh-personal-workbench.git"
  },
  "bugs": {
    "url": "https://github.com/xuanqing-lab/dsh-personal-workbench/issues"
  },
  "license": "SEE LICENSE IN LICENSE"
}
